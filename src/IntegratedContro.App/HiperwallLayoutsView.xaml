<UserControl x:Class="IntegratedContro.App.HiperwallLayoutsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:core="clr-namespace:IntegratedContro.Core;assembly=IntegratedContro.Core">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <Button DockPanel.Dock="Right" Content="저장 배치 · 작업 새로 고침" Command="{Binding RefreshLayoutsCommand}"/>
   <StackPanel><TextBlock Text="저장 배치 · 수동 표시 · 복구" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="배치 저장은 LIVE를 변경하지 않습니다. 표시와 자동 정리는 공통 호스트에서 이어집니다." Style="{DynamicResource Muted}" Margin="0,6"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="{DynamicResource SubtleSurface}" Padding="10" CornerRadius="6" Margin="0,0,0,12">
   <TextBlock Text="{Binding LayoutMessage}" TextWrapping="Wrap"/>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width=".8*" MinWidth="200"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.6*" MinWidth="355"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.1*" MinWidth="260"/></Grid.ColumnDefinitions>
   <Border Style="{DynamicResource Panel}"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="저장한 배치" FontSize="18" Margin="0,0,0,10"/>
    <ListBox Grid.Row="1" ItemsSource="{Binding SavedLayouts}" SelectedItem="{Binding SelectedLayout}" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,6"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
      <TextBlock Style="{DynamicResource Muted}"><Run Text="v"/><Run Text="{Binding Version, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Duration.Label, Mode=OneWay}"/></TextBlock>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Margin="0,10,0,0">
     <Button Content="초안으로 불러오기" Command="{Binding LoadLayoutCommand}" Margin="0,3"/>
     <Button Content="저장 배치 표시" Command="{Binding ShowLayoutCommand}" Margin="0,3" AutomationProperties.AutomationId="ShowSavedLayout" Style="{StaticResource Primary}"/>
     <Button Content="저장 배치 삭제" Command="{Binding DeleteLayoutCommand}" Margin="0,3" Style="{StaticResource Danger}"/>
     <TextBlock Text="삭제·수정 후에도 이미 접수된 표시는 원래 배치를 유지합니다." Style="{DynamicResource Muted}" Margin="0,8"/>
    </StackPanel>
   </Grid></Border>
   <Border Grid.Column="2" Style="{DynamicResource Panel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <DockPanel><Button DockPanel.Dock="Right" Content="새 배치" Command="{Binding NewLayoutCommand}"/><TextBlock Text="배치 초안" FontSize="18"/></DockPanel>
     <TextBlock Text="{Binding DraftVersionLabel}" Style="{DynamicResource Muted}" Margin="0,6"/>
     <TextBlock Text="배치 이름"/><TextBox Text="{Binding LayoutName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="LayoutName"/>
     <Button Content="현재 조회한 LIVE를 초안으로 복사" Command="{Binding CaptureLayoutCommand}" Margin="0,0,0,10"/>
     <ListBox Height="120" ItemsSource="{Binding DraftPlacements}" SelectedItem="{Binding SelectedPlacement}" DisplayMemberPath="Label" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}"/>
     <TextBlock Text="초안 콘텐츠 · Zone" Margin="0,12,0,5"/>
     <ComboBox ItemsSource="{Binding Contents}" SelectedItem="{Binding DraftContent}" DisplayMemberPath="Name" Margin="0,0,0,6"/>
     <ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding DraftZone}" DisplayMemberPath="Name"/>
     <UniformGrid Columns="2" Margin="0,8,0,0">
      <StackPanel Margin="0,0,5,0"><TextBlock Text="중심 X" Style="{DynamicResource Muted}"/><TextBox Text="{Binding DraftX, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Margin="5,0,0,0"><TextBlock Text="중심 Y" Style="{DynamicResource Muted}"/><TextBox Text="{Binding DraftY, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Margin="0,0,5,0"><TextBlock Text="너비" Style="{DynamicResource Muted}"/><TextBox Text="{Binding DraftWidth, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Margin="5,0,0,0"><TextBlock Text="높이" Style="{DynamicResource Muted}"/><TextBox Text="{Binding DraftHeight, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     </UniformGrid>
     <WrapPanel><Button Content="초안에 추가" Command="{Binding AddPlacementCommand}"/><Button Content="선택 항목 수정" Command="{Binding UpdatePlacementCommand}"/><Button Content="제거" Command="{Binding RemovePlacementCommand}" Style="{StaticResource Danger}"/></WrapPanel>
     <TextBlock Text="저장 배치 표시 시간" Margin="0,14,0,6"/>
     <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding DurationMode}">
      <ComboBoxItem Content="기본 15초" Tag="{x:Static core:DisplayDurationMode.Default}"/>
      <ComboBoxItem Content="지정 시간" Tag="{x:Static core:DisplayDurationMode.Timed}"/>
      <ComboBoxItem Content="계속 표시" Tag="{x:Static core:DisplayDurationMode.Continuous}"/>
     </ComboBox>
     <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTimedDuration}" ToolTip="1~86400초 정수"/>
     <WrapPanel><Button Content="배치 저장" Command="{Binding SaveLayoutCommand}" AutomationProperties.AutomationId="SaveLayout" Style="{StaticResource Primary}"/>
      <Button Content="초안 15초 테스트" Command="{Binding TestLayoutCommand}" AutomationProperties.AutomationId="TestLayout"/></WrapPanel>
     <TextBlock Text="테스트는 저장하지 않고 표시합니다. 종료 예정 시각을 먼저 저장하며 재시작 후 남은 인스턴스를 정리합니다." Style="{DynamicResource Muted}" Margin="0,10"/>
    </StackPanel></ScrollViewer>
   </Border>
   <Border Grid.Column="4" Style="{DynamicResource Panel}"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="1.3*"/></Grid.RowDefinitions>
    <TextBlock Text="표시 · 정리 작업" FontSize="18" Margin="0,0,0,10"/>
    <ListBox Grid.Row="1" ItemsSource="{Binding DisplayJobs}" SelectedItem="{Binding SelectedDisplay}" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,6">
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Schedule}" Style="{DynamicResource Muted}"/>
      <TextBlock Style="{DynamicResource Muted}"><Run Text="{Binding Requester.UserName, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Requester.PcName, Mode=OneWay}"/></TextBlock>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Button Grid.Row="2" Content="선택 표시 종료 · 정리 재시도" Command="{Binding StopDisplayCommand}" Margin="0,10" AutomationProperties.AutomationId="StopDisplay"/>
    <TextBox Grid.Row="3" Text="{Binding DisplayDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12"/>
   </Grid></Border>
  </Grid>
 </Grid>
</UserControl>
