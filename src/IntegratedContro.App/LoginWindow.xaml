<Window x:Class="IntegratedContro.App.LoginWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource AppWindow}" Title="IntegratedContro · 접속" Width="560" MaxHeight="820" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource AppBackground}">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Margin="20" Padding="28"><StackPanel>
  <DockPanel Margin="0,0,0,20">
   <Button x:Name="OpenConnectionSettings" DockPanel.Dock="Right" Content="접속 설정" Command="{Binding OpenConnectionSettingsCommand}"
    Visibility="{Binding IsLoginPage, Converter={StaticResource BoolVisibility}}" Padding="10,5" Margin="12,0,0,0"/>
   <TextBlock Text="{Binding LoginPageTitle}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
  </DockPanel>
  <Border x:Name="PreferencesRecoveryPanel" Visibility="{Binding HasPreferencesRecovery, Converter={StaticResource BoolVisibility}}"
   Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource WarningLine}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
   <StackPanel>
    <TextBlock Text="접속 설정 복구" FontWeight="Bold" Foreground="{DynamicResource WarningInk}" Margin="0,0,0,6"/>
    <TextBlock Text="{Binding PreferencesRecoveryMessage}" TextWrapping="Wrap" Foreground="{DynamicResource WarningInk}"/>
    <TextBlock Text="{Binding PreferencesBackupSummary}" TextWrapping="Wrap" Foreground="{DynamicResource WarningInk}" Margin="0,8,0,4"/>
    <WrapPanel>
     <Button x:Name="RestorePreferencesBackup" Content="백업 설정 복구" Command="{Binding RestorePreferencesBackupCommand}" MinHeight="48"/>
     <Button x:Name="ReloadPreferences" Content="설정 다시 읽기" Command="{Binding ReloadPreferencesCommand}" MinHeight="48" Margin="8,0,0,0"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <StackPanel x:Name="LoginPage" Visibility="{Binding IsLoginPage, Converter={StaticResource BoolVisibility}}">
   <TextBlock Text="{Binding LoginHostSummary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,20"/>
   <StackPanel IsEnabled="{Binding CanEditLogin}">
    <TextBlock Text="앱 계정 아이디"/><TextBox x:Name="LoginNameInput" Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" Margin="0,5,0,16"/>
    <TextBlock Text="비밀번호"/><PasswordBox x:Name="LoginPassword" MinHeight="48" Margin="0,5,0,10"/>
   </StackPanel>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}" Margin="0,18,0,14"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="취소" IsCancel="True" MinHeight="48"/>
    <Button x:Name="ConnectButton" Content="접속" IsDefault="True" Command="{Binding LoginCommand}" Style="{StaticResource Primary}" MinHeight="48" MinWidth="88" Margin="8,0,0,0"/>
   </StackPanel>
  </StackPanel>
  <StackPanel x:Name="ConnectionSettingsPage" Visibility="{Binding IsEditingConnectionSettings, Converter={StaticResource BoolVisibility}}">
   <StackPanel IsEnabled="{Binding CanEditLogin}">
    <TextBlock Text="호스트 HTTPS 주소"/><TextBox x:Name="HostEndpoint" Text="{Binding ConnectionEndpoint, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" Margin="0,5,0,16"/>
    <TextBlock Text="호스트 인증서 SHA-256 지문"/><TextBox x:Name="CertificateFingerprint" Text="{Binding ConnectionFingerprint, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" MinHeight="50" Margin="0,5,0,4"/>
    <TextBlock Text="호스트에서 확인한 주소와 인증서 지문을 입력하세요. 이 PC에 저장됩니다." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,12"/>
   </StackPanel>
   <TextBlock Text="{Binding ConnectionSettingsMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DangerInk}" Margin="0,6,0,14"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="CancelConnectionSettings" Content="돌아가기" Command="{Binding CancelConnectionSettingsCommand}" MinHeight="48"/>
    <Button x:Name="SaveConnectionSettings" Content="설정 저장" IsDefault="True" Command="{Binding SaveConnectionSettingsCommand}" Style="{StaticResource Primary}" MinHeight="48" Margin="8,0,0,0"/>
   </StackPanel>
  </StackPanel>
 </StackPanel></Border></ScrollViewer>
</Window>
