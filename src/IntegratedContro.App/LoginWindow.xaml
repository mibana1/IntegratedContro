<Window x:Class="IntegratedContro.App.LoginWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="IntegratedContro · 호스트 접속" Width="540" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F3F6FA">
 <StackPanel Margin="28">
  <TextBlock Text="호스트에 접속" FontSize="25" FontWeight="Bold" Foreground="#172B46"/>
  <TextBlock Text="현장의 호스트 주소와 앱 계정으로 로그인하세요." Margin="0,8,0,24" Foreground="#596E85"/>
  <StackPanel IsEnabled="{Binding CanEditLogin}">
   <TextBlock Text="호스트 HTTPS 주소"/><TextBox x:Name="HostEndpoint" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Margin="0,5,0,16"/>
   <TextBlock Text="호스트 인증서 SHA-256 지문"/><TextBox x:Name="CertificateFingerprint" Text="{Binding Fingerprint, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" MinHeight="50" Margin="0,5,0,4"/>
   <TextBlock Text="호스트 최초 설정 또는 실행 콘솔에 표시된 지문을 입력하세요." TextWrapping="Wrap" FontSize="11" Foreground="#596E85" Margin="0,0,0,16"/>
   <TextBlock Text="앱 계정"/><TextBox x:Name="LoginNameInput" Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Margin="0,5,0,16"/>
   <TextBlock Text="비밀번호"/><PasswordBox x:Name="LoginPassword" MinHeight="36" Margin="0,5,0,10"/>
  </StackPanel>
  <TextBlock Text="비밀번호는 저장하지 않습니다." FontSize="11" Foreground="#596E85"/>
  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#375774" Margin="0,18,0,14"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="취소" IsCancel="True" IsEnabled="{Binding CanEditLogin}" MinHeight="36"/>
   <Button x:Name="ConnectButton" Content="접속" IsDefault="True" Command="{Binding LoginCommand}" Style="{StaticResource Primary}" MinHeight="36" MinWidth="88" Margin="8,0,0,0"/>
  </StackPanel>
 </StackPanel>
</Window>
