<UserControl x:Class="IntegratedContro.App.HiperwallView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:IntegratedContro.App" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}">
 <UserControl.Resources>
  <local:HiperwallZoneMatchConverter x:Key="ZoneMatch"/>
  <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
   <Setter Property="CanUserSortColumns" Value="False"/><Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
  </Style>
 </UserControl.Resources>
 <TabControl x:Name="HiperwallWorkTabs" Margin="8" Background="{DynamicResource AppBackground}" BorderThickness="0"><TabItem Header="LIVE 편집"><Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="2,0,2,10">
   <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="목록 새로 고침" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="HiperwallRefresh" Background="{DynamicResource AccentSoft}"/>
   <StackPanel>
    <StackPanel Orientation="Horizontal"><TextBlock Text="Hiperwall 편집" FontSize="23" FontWeight="Bold"/>
     <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="10,4" Margin="14,2"><TextBlock Text="{Binding EditMode}" Foreground="{DynamicResource Accent}" FontSize="12"/></Border>
     <TextBlock Text="{Binding Status}" Margin="8,6,0,0" FontWeight="SemiBold" Foreground="{DynamicResource WarningInk}"/>
    </StackPanel>
    <TextBlock Text="{Binding CurrentConnection}" Margin="0,4,0,3"/>
    <WrapPanel><TextBlock Text="{Binding ControllerInfo}" Style="{StaticResource Muted}" Margin="0,0,18,0"/><TextBlock Text="{Binding LastSuccess}" Style="{StaticResource Muted}"/></WrapPanel>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="{DynamicResource SubtleSurface}" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"/></Border>
  <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
      <Button x:Name="SaveLayoutSlot" Content="현재 상태 저장" MinHeight="48" Command="{Binding SaveSlotCommand}" ToolTip="{Binding SaveSlotToolTip}" ToolTipService.ShowOnDisabled="True"/>
      <Button x:Name="DeleteLayoutSlot" Content="저장 삭제" MinHeight="48" Command="{Binding DeleteSlotCommand}" ToolTip="{Binding DeleteSlotToolTip}" ToolTipService.ShowOnDisabled="True" Style="{StaticResource Danger}"/>
      <Button x:Name="RestoreLayoutSlot" Content="불러오기" MinHeight="48" Command="{Binding RestoreSlotCommand}" ToolTip="{Binding RestoreSlotToolTip}" ToolTipService.ShowOnDisabled="True" Style="{StaticResource Primary}"/>
     </StackPanel>
    <ItemsControl x:Name="LayoutSlotButtons" ItemsSource="{Binding LayoutSlots}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Button Command="{Binding SelectCommand}" MinHeight="48" Padding="8,4" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Title}">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True">
         <Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </DataTrigger></Style.Triggers>
       </Style></Button.Style>
       <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedInk}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
       </StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl></DockPanel>
    <TextBlock Grid.Row="1" Text="{Binding SlotMessage}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningInk}" Margin="3,6,0,0">
     <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
      <DataTrigger Binding="{Binding SlotMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
     </Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
  </Border>
  <ScrollViewer x:Name="LiveEditorScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
  <Grid MinHeight="670" Height="{Binding ViewportHeight, ElementName=LiveEditorScroll}">
   <Grid.ColumnDefinitions><ColumnDefinition Width=".9*" MinWidth="225"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*" MinWidth="365"/><ColumnDefinition Width="12"/><ColumnDefinition Width=".9*" MinWidth="225"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="CONTENTS LIBRARY" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="Bold"/><TextBlock Text="Contents" FontSize="19" FontWeight="SemiBold" Margin="0,4"/><TextBlock Text="{Binding ContentCount}" Style="{StaticResource Muted}"/></StackPanel>
     <Grid Grid.Row="1"><TextBox x:Name="ContentSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="이름·경로·UUID·유형 검색" AutomationProperties.Name="Contents 이름 UUID 유형 검색"/>
      <TextBlock Text="이름 · UUID · 유형 검색" Margin="9,6,9,8" VerticalAlignment="Center" Foreground="{DynamicResource MutedInk}" IsHitTestVisible="False">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock></Grid>
     <ComboBox x:Name="ContentTypePicker" Grid.Row="2" ItemsSource="{Binding ContentTypes}" SelectedItem="{Binding TypeFilter}" Margin="0,0,0,10" Foreground="{DynamicResource Ink}" AutomationProperties.Name="Contents 유형 필터"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource Ink}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
     <TextBlock Grid.Row="3" Text="{Binding ContentState}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
     <ListBox PreviewMouseLeftButtonDown="ContentPointerDown" PreviewMouseMove="ContentPointerMove" x:Name="ContentList" Grid.Row="4" ItemsSource="{Binding FilteredContents}" SelectedItem="{Binding SelectedContent}"
      Background="{DynamicResource Surface}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
      <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold" Margin="4,12,0,6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>

      <ListBox.ItemTemplate><DataTemplate><StackPanel>
       <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
       <TextBlock FontSize="12" Foreground="{DynamicResource MutedInk}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Type, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Identity, Mode=OneWay}"/></TextBlock>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="5" Margin="0,12,0,0">
      <Button Content="선택 콘텐츠 추가" Command="{Binding AddContentCommand}" AutomationProperties.AutomationId="HiperwallAdd" Style="{StaticResource Primary}"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Panel}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="180"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="264" MaxHeight="280"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Wall · Zone · 이미지 프리뷰" ToolTip="{Binding CanvasSummary}" FontSize="19" FontWeight="SemiBold" Margin="0,4"/>
     <WrapPanel Grid.Row="1" Margin="0,6,0,8">
      <Button Content="−" Click="ZoomOut" AutomationProperties.Name="캔버스 축소"/><TextBlock Text="{Binding ZoomLabel, ElementName=WallCanvas}" VerticalAlignment="Center" MinWidth="54" TextAlignment="Center"/>
      <Button Content="+" Click="ZoomIn" AutomationProperties.Name="캔버스 확대"/><Button Content="전체" Click="FitAll" ToolTip="캔버스 전체 맞춤" AutomationProperties.Name="캔버스 전체 맞춤"/><Button Content="선택" Click="FitSelected" ToolTip="선택 콘텐츠 맞춤" AutomationProperties.Name="선택 콘텐츠 맞춤"/>

     </WrapPanel>
     <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
      <local:HiperwallCanvas x:Name="WallCanvas" PreviewKeyDown="RemoveInstanceKeyDown" Items="{Binding CanvasItems}" Selected="{Binding Selected}" CanManipulate="{Binding CanMove}" LockAspect="{Binding LockAspect}" SnapToGrid="{Binding SnapToGrid}" TargetZone="{Binding TargetZone}"
       AllowDrop="True" DragOver="CanvasDragOver" Drop="CanvasDrop" AutomationProperties.Name="Hiperwall 편집 캔버스" ToolTip="노란 테두리와 !는 프리뷰 갱신 실패입니다. 이전 이미지를 유지하며 편집할 수 있습니다."/>
     </Border>
     <StackPanel Grid.Row="3" Margin="0,6,0,5">
      <ScrollViewer x:Name="ZoneShortcutScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" MaxHeight="72">
       <ItemsControl x:Name="ZoneShortcuts" ItemsSource="{Binding Zones}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Button Tag="{Binding}" Click="ZoneButtonClick" AllowDrop="True" DragOver="ZoneButtonDragOver" DragLeave="ZoneButtonDragLeave" Drop="ZoneButtonDrop"
          IsEnabled="{Binding CanNavigateZone}" MinHeight="48" Padding="10,4" Margin="0,0,6,0" MaxWidth="180" ToolTip="{Binding ZoneShortcutLabel}" AutomationProperties.Name="{Binding ZoneShortcutLabel}">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
           <Style.Triggers>
            <DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource ZoneMatch}">
             <Binding/><Binding Path="DataContext.TargetZone" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
            </MultiBinding></DataTrigger.Binding><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger>
            <Trigger Property="local:HiperwallView.IsZoneDropTarget" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningInk}"/></Trigger>
           </Style.Triggers>
          </Style></Button.Style>
          <TextBlock Text="{Binding ZoneShortcutLabel}" TextTrimming="CharacterEllipsis" FontSize="12"/>
         </Button>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
      <TextBlock Text="Zone 버튼: 화면 이동 · 소스를 버튼에 놓기: 크기 유지 이동" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
       ToolTip="Zone 버튼을 클릭하면 해당 영역을 봅니다. 열린 소스를 버튼에 놓으면 원래 크기로 Zone 중앙에 이동합니다. Contents를 놓으면 원본 크기로 추가합니다. 마우스·터치 이동 / 모서리 크기 조절 / 휠 확대 / Delete·Backspace: 선택 콘텐츠 삭제 / Esc 취소."/>
     </StackPanel>
     <TabControl Grid.Row="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" Padding="0">
      <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
       <Setter Property="Padding" Value="10,12"/><Setter Property="Margin" Value="0,0,2,6"/>
      </Style></TabControl.Resources>
      <TabItem Header="열린 콘텐츠">
       <Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding InstanceBrief}" ToolTip="{Binding InstanceState}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
        <DataGrid x:Name="InstanceGrid" PreviewKeyDown="RemoveInstanceKeyDown" CanUserDeleteRows="False" Grid.Row="1" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"><DataGrid.Columns>
         <DataGridTextColumn Header="콘텐츠 이름" Binding="{Binding Name}" Width="*" MinWidth="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Name}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
         <DataGridTextColumn Header="인스턴스 ID" Binding="{Binding Identity}" Width="*" MinWidth="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Identity}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
        </DataGrid.Columns></DataGrid>
       </Grid>
      </TabItem>
      <TabItem Header="Zone">
       <Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding ZoneBrief}" ToolTip="{Binding ZoneState}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
        <DataGrid x:Name="ZoneGrid" Grid.Row="1" ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}"><DataGrid.Columns>
         <DataGridTextColumn Header="Zone 이름" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Zone ID" Binding="{Binding Identity}" Width="*"/>
        </DataGrid.Columns></DataGrid>
       </Grid>
      </TabItem>
      <TabItem Header="Wall">
       <Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding WallBrief}" ToolTip="{Binding WallState}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Walls}" SelectedItem="{Binding SelectedWall}"><DataGrid.Columns>
         <DataGridTextColumn Header="Wall 이름" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="식별자" Binding="{Binding Identity}" Width="*"/>
        </DataGrid.Columns></DataGrid>
       </Grid>
      </TabItem>
      <TabItem Header="전송 기록">
       <Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel><Button Content="전송 기록 확인" Command="{Binding CheckEditCommand}"/><Button Content="선택 기록의 남은 전송 취소" Command="{Binding CancelEditCommand}"/></WrapPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding EditHistory}" SelectedItem="{Binding SelectedEdit}" DisplayMemberPath="Summary" ToolTip="{Binding EditDetails}" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderThickness="0" Margin="0,6,0,0"/>
       </Grid>
      </TabItem>
     </TabControl>

    </Grid>
   </Border>
   <Border Grid.Column="4" Style="{StaticResource Panel}">
    <ScrollViewer x:Name="LiveControlsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="LIVE CONTROLS" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="Bold"/>
      <TextBlock Text="선택 콘텐츠 편집" FontSize="19" FontWeight="SemiBold" Margin="0,4"/>
      <TextBlock Text="{Binding SelectedName}" Foreground="{DynamicResource WarningInk}" TextWrapping="Wrap" Margin="0,10"/>
      <Button x:Name="DeleteInstanceButton" Content="선택 삭제" Command="{Binding CloseInstanceCommand}" Style="{StaticResource Danger}"
       ToolTip="선택한 열린 콘텐츠를 Zone에서 제거합니다. Delete / Backspace" AutomationProperties.AutomationId="HiperwallDeleteInstance"/>
      <TextBlock Text="{Binding EditHint}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
      <TextBlock Text="배치할 Zone" FontWeight="SemiBold"/>
      <ComboBox x:Name="EditZonePicker" ItemsSource="{Binding Zones}" SelectedItem="{Binding TargetZone}" ToolTip="{Binding TargetZone.Identity}" Foreground="{DynamicResource Ink}" Margin="0,7,0,12" IsEnabled="{Binding CanOperate}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Foreground="{DynamicResource Ink}"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Identity, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <TextBlock Text="위치 · 크기 (절대 px)" FontWeight="SemiBold"/>
      <UniformGrid Columns="2" Margin="0,5,0,0">
       <StackPanel Margin="0,0,5,0"><TextBlock Text="중심 X" Style="{StaticResource Muted}"/><TextBox x:Name="EditX" Text="{Binding EditX, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="중심 X"/></StackPanel>
       <StackPanel Margin="5,0,0,0"><TextBlock Text="중심 Y" Style="{StaticResource Muted}"/><TextBox x:Name="EditY" Text="{Binding EditY, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="중심 Y"/></StackPanel>
       <StackPanel Margin="0,0,5,0"><TextBlock Text="너비" Style="{StaticResource Muted}"/><TextBox x:Name="EditWidth" Text="{Binding EditWidth, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="너비"/></StackPanel>
       <StackPanel Margin="5,0,0,0"><TextBlock Text="높이" Style="{StaticResource Muted}"/><TextBox x:Name="EditHeight" Text="{Binding EditHeight, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="높이"/></StackPanel>
      </UniformGrid>
      <WrapPanel><Button Content="위치·크기 적용" Command="{Binding ApplyGeometryCommand}" AutomationProperties.AutomationId="HiperwallGeometry"/><Button Content="Zone 중앙 이동" Command="{Binding CenterInZoneCommand}"/></WrapPanel>
      <CheckBox Content="크기 드래그 시 비율 유지" IsChecked="{Binding LockAspect}" Foreground="{DynamicResource Ink}" Margin="4,12,0,5"/>
      <CheckBox Content="드래그 시 Zone 격자 맞춤" IsChecked="{Binding SnapToGrid}" Foreground="{DynamicResource Ink}" Margin="4,0,0,12" ToolTip="Controller가 제공한 Zone 격자 수를 사용합니다."/>
      <TextBlock Text="Zone 밖으로 이동할 수 있습니다. Zone 이동은 현재 크기를 유지합니다." Style="{StaticResource Muted}"/>
      <Border Height="1" Background="{DynamicResource Line}" Margin="0,16"/>
      <DockPanel><TextBlock Text="콘텐츠 소리" FontWeight="SemiBold"/><TextBlock Text="{Binding EditVolume, StringFormat={}{0}%}" HorizontalAlignment="Right" Foreground="{DynamicResource WarningInk}"/></DockPanel>
      <local:TouchSlider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding EditVolume}" IsEnabled="{Binding CanAudio}" Margin="0,12" AutomationProperties.Name="선택 콘텐츠 음량"/>
      <WrapPanel><Button Content="음량 적용" Command="{Binding ApplyVolumeCommand}"/><Button Content="{Binding MuteLabel}" Command="{Binding MuteCommand}"/></WrapPanel>
      <TextBlock Text="음량 적용은 현재 음소거 상태를 유지합니다. 소리 정보가 없는 콘텐츠는 조절할 수 없습니다." Style="{StaticResource Muted}" Margin="0,10"/>
      <Expander Header="현재 관측 · 원문 필드" Foreground="{DynamicResource Ink}" Margin="0,10,0,0">
       <StackPanel><TextBlock Text="{Binding SelectedGeometry}" Style="{StaticResource Muted}" Margin="0,8"/><TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="200" VerticalScrollBarVisibility="Auto" FontSize="12"/></StackPanel>
      </Expander>
      <TextBlock Text="전체 콘텐츠 조작" FontWeight="SemiBold" Margin="0,20,0,6"/>
     <Grid Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <WrapPanel>
       <Button Content="전체 음소거" Command="{Binding MuteAllCommand}" Padding="7,7"/><Button Content="전체 음소거 해제" Command="{Binding UnmuteAllCommand}" Padding="7,7"/>
       <Button x:Name="CloseAllButton" Content="전체 닫기…" Command="{Binding CloseAllCommand}" Padding="7,7" Style="{StaticResource Danger}"/>
      </WrapPanel>
      <TextBlock x:Name="EditResultSummary" Grid.Row="1" Text="{Binding EditResult}" ToolTip="{Binding EditResult}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxHeight="44" VerticalAlignment="Center" Margin="8,0,0,0"/>
     </Grid>
      <Expander Header="선택 전송 기록 상세" Foreground="{DynamicResource Ink}" Margin="0,10,0,0"><TextBox Text="{Binding EditDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="200" VerticalScrollBarVisibility="Auto" FontSize="12"/></Expander>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid></ScrollViewer>
 </Grid></TabItem><TabItem x:Name="LayoutsTab" Header="저장 배치 · 표시 · 복구"><local:HiperwallLayoutsView/></TabItem></TabControl>
</UserControl>
