<Window x:Class="IntegratedContro.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IntegratedContro.App"
 Title="IntegratedContro · 운영 콘솔" Width="1500" Height="1000" MinWidth="1180" MinHeight="860" WindowStartupLocation="CenterScreen" Closing="OnClosing">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TabControl x:Name="MainTabs" Margin="18,12,18,12" Background="Transparent" BorderBrush="#D5DFEA">
   <TabItem Header="장비 제어">
    <TabControl x:Name="DeviceViews" SelectedIndex="{Binding DeviceViewIndex}" BorderThickness="0" Background="#F3F6FA" Margin="8">
     <TabItem Header="조명 모아보기"><local:LightingView/></TabItem>
     <TabItem Header="장비 목록 · 상세 조작">
    <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
     <Grid Margin="0,0,16,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="등록 장비와 가상 상태" Style="{StaticResource SectionTitle}"/><TextBlock Text="요청값과 가상 상태를 구분합니다. 실제 PC 이름은 표시용이며, 제어 대상은 PC ID·장비 ID로 고정됩니다." TextWrapping="Wrap" Foreground="#65778E" Margin="0,0,0,12"/></StackPanel>
      <DataGrid x:Name="DeviceGrid" Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutomationProperties.AutomationId="DeviceGrid">
       <DataGrid.Columns><DataGridTextColumn Header="장비" Binding="{Binding Name}" Width="140"/><DataGridTextColumn Header="대상 PC 이름" Binding="{Binding PcName}" Width="170"/><DataGridTextColumn Header="가상 상태 · 확인 시각" Binding="{Binding State}" Width="*"/><DataGridTextColumn Header="요청값" Binding="{Binding Desired}" Width="130"/><DataGridTextColumn Header="제한" Binding="{Binding Restriction}" Width="110"/></DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding SelectedDevice.Connection}"/><TextBlock Text="{Binding SelectedDevice.Result}" TextWrapping="Wrap" Foreground="#65778E"/><TextBlock Text="{Binding SelectedDevice.Config.Id, StringFormat=장비 ID: {0}}" FontFamily="Consolas" FontSize="11"/><TextBlock Text="{Binding SelectedDevice.Config.PcId, StringFormat=PC ID: {0}}" FontFamily="Consolas" FontSize="11"/>
       <WrapPanel><Button Content="선택 장비 가상 상태 조회·대조" Command="{Binding ReconcileCommand}"/><Button Content="선택 장비를 설정 편집에 불러오기" Command="{Binding LoadDeviceCommand}"/></WrapPanel>
       <Border BorderBrush="#D5DFEA" BorderThickness="1" Background="#F3F6FA" Padding="10" Margin="0,8,0,0"><StackPanel>
        <TextBlock Text="선택 장비 역할 배정 · 관리자" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding RoleTargetSummary}" TextWrapping="Wrap" Margin="0,4"/>
        <local:RoleAssignmentsView x:Name="QuickRoleAssignments" Compact="True"/>
        <WrapPanel><TextBlock Text="역할 ID" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="QuickRoleName" Text="{Binding RoleName, UpdateSourceTrigger=PropertyChanged}" Width="200" IsEnabled="{Binding CanConfigure}" ToolTip="예: room.light"/><Button x:Name="QuickAssignRole" Content="선택 장비에 역할 배정" Command="{Binding SaveRoleCommand}"/></WrapPanel>
        <TextBlock Text="{Binding RoleAssignmentHint}" TextWrapping="Wrap" Foreground="#536C85"/>
       </StackPanel></Border>
      </StackPanel>
     </Grid>
     <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="역할로 조작" Style="{StaticResource SectionTitle}"/><TextBlock Text="역할"/><ComboBox x:Name="ControlRolePicker" ItemsSource="{Binding Roles}" DisplayMemberPath="Id" SelectedItem="{Binding SelectedRole}" AutomationProperties.AutomationId="ControlRole"/>
      <TextBlock Text="지원 기능"/><ComboBox x:Name="ControlCapabilityPicker" ItemsSource="{Binding Capabilities}" DisplayMemberPath="Operation" SelectedItem="{Binding SelectedCapability}"/>
      <TextBlock Text="{Binding CommandRange}" Foreground="#156D68" TextWrapping="Wrap"/>
      <local:PowerButtons x:Name="ManualPowerButtons" Value="{Binding CommandValue}" Visibility="{Binding IsPowerCommand, Converter={StaticResource BoolVisibility}}"/>
      <TextBox x:Name="ManualNumericValue" Text="{Binding CommandValue, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Visibility="{Binding IsNumericCommand, Converter={StaticResource BoolVisibility}}"/>
      <TextBlock Text="전송 전 대기 (ms)"/><TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
      <TextBlock Text="단계 제한시간 (ms)"/><TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
      <Button Content="일반 명령 접수" Command="{Binding SubmitCommand}" Style="{StaticResource Primary}" AutomationProperties.AutomationId="SubmitCommandButton"/>
      <TextBlock Text="예약 충돌 시 작업 탭에서 해당 시나리오를 선택해 명시적으로 중단·전환하세요. 충돌 명령은 자동 재전송하지 않습니다." TextWrapping="Wrap" Foreground="#65778E" Margin="0,12,0,0"/>
     </StackPanel></ScrollViewer></Border>
    </Grid>
     </TabItem>
    </TabControl>
   </TabItem>
   <TabItem x:Name="HiperwallTab" Header="Hiperwall 편집"><local:HiperwallView x:Name="HiperwallInventory" DataContext="{Binding Hiperwall}"/></TabItem>
   <TabItem x:Name="CameraTab" Header="카메라 · 영상"><local:CameraView x:Name="CameraWorkspace" DataContext="{Binding Cameras}"/></TabItem>
   <TabItem x:Name="ScenarioTab" Header="시나리오">
    <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel Margin="0,0,18,0">
      <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
       <Button x:Name="AddScenarioStep" Content="선택 설정을 단계로 추가" Command="{Binding AddStepCommand}"/>
       <Button x:Name="SaveScenarioDefinition" Content="정의 저장 (관리자)" Command="{Binding SaveScenarioCommand}" Style="{StaticResource Primary}"/>
      </StackPanel>
     <ScrollViewer x:Name="ScenarioSettingsScroll" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="순차 시나리오" Style="{StaticResource SectionTitle}"/>
      <ComboBox x:Name="SavedScenarioPicker" ItemsSource="{Binding Scenarios}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedScenario}"/>
      <WrapPanel><Button Content="실행" Command="{Binding RunScenarioCommand}" Style="{StaticResource Primary}"/><Button Content="편집에 불러오기" Command="{Binding LoadScenarioCommand}"/><Button Content="새 정의" Command="{Binding NewScenarioCommand}"/></WrapPanel>
      <Button x:Name="DeleteScenarioDefinition" Content="저장 시나리오 삭제" Command="{Binding DeleteScenarioCommand}" HorizontalAlignment="Left"/>
      <TextBlock Text="{Binding ScenarioDeletionHint}" TextWrapping="Wrap" Foreground="#65778E" Margin="0,2,0,6"/>
      <TextBlock Text="정의 이름" Margin="0,10,0,0"/><TextBox Text="{Binding ScenarioName, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="추가할 단계" FontWeight="SemiBold" Margin="0,8,0,0"/>
      <ComboBox x:Name="ScenarioKindPicker" ItemsSource="{Binding ScenarioKinds}" DisplayMemberPath="Label" SelectedValuePath="Kind" SelectedValue="{Binding DraftStepKind}"/>
      <TextBlock Text="{Binding ScenarioStepHint}" TextWrapping="Wrap" Foreground="#65778E" Margin="0,4,0,8"/>
      <StackPanel Visibility="{Binding IsDeviceScenarioStep, Converter={StaticResource BoolVisibility}}">
       <TextBlock Text="설정할 장비 · 역할"/>
       <ComboBox x:Name="ScenarioTargetPicker" ItemsSource="{Binding ScenarioTargets}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedScenarioTarget}" ToolTip="{Binding SelectedScenarioTarget.Label}"/>
       <TextBlock Text="{Binding ScenarioSettingsHint}" TextWrapping="Wrap" Foreground="#65778E" Margin="0,0,0,8"/>
       <local:ScenarioSettingsView x:Name="ScenarioDeviceSettings"/>
      </StackPanel>
      <StackPanel Visibility="{Binding IsDisplayScenarioStep, Converter={StaticResource BoolVisibility}}">
       <TextBlock Text="저장 배치"/><ComboBox x:Name="ScenarioLayoutPicker" ItemsSource="{Binding ScenarioLayouts}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedScenarioLayout}"/>
       <TextBlock Text="배치는 Hiperwall 편집 → 저장 배치에서 먼저 저장하세요." TextWrapping="Wrap" Foreground="#65778E"/>
      </StackPanel>
      <TextBlock Text="시작 전 대기 / 제한시간 (ms)"/>
      <TextBlock Text="여러 설정을 추가하면 시작 전 대기는 첫 단계에 적용합니다." TextWrapping="Wrap" Foreground="#65778E" FontSize="11"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <TextBox Text="{Binding DelayMs, ValidatesOnExceptions=True}" ToolTip="단계 시작 전 대기: 0~3600000ms"/>
       <TextBox Grid.Column="1" Text="{Binding TimeoutMs, ValidatesOnExceptions=True}" ToolTip="장비 명령: 100~30000ms / 조건 대기·표시: 100~3600000ms"/>
      </Grid>
      <TextBlock Text="실패 정책 (Stop: 중단 / Continue: 다음 단계)"/><ComboBox ItemsSource="{Binding FailurePolicies}" SelectedItem="{Binding DraftFailurePolicy}"/>
      <Expander x:Name="ScenarioConditionExpander" Header="전송 직전 확인 조건 (선택)" Visibility="{Binding IsCommandScenarioStep, Converter={StaticResource BoolVisibility}}"><StackPanel>
       <TextBlock Text="전송 직전 한 번 확인할 조건 (선택)"/>
       <ComboBox x:Name="ConditionOperationPicker" ItemsSource="{Binding ConditionOperations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ConditionOperationText}"/>
       <local:PowerButtons x:Name="ConditionPowerButtons" Value="{Binding ConditionPowerValue}" Visibility="{Binding IsPowerCondition, Converter={StaticResource BoolVisibility}}"/>
       <StackPanel Visibility="{Binding IsNumericCondition, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{Binding ConditionRange}" Foreground="#156D68"/>
        <TextBox x:Name="ConditionNumericValue" Text="{Binding ConditionValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="조건 기대값"/>
       </StackPanel>
      </StackPanel></Expander>
      <TextBlock Text="시작 시 모든 대상과 저장 배치를 고정·예약합니다. 권한·설정 변경과 불확실 결과는 실패 정책과 관계없이 후속 단계를 차단합니다." TextWrapping="Wrap" Foreground="#65778E" Margin="0,10,0,0"/>
     </StackPanel></ScrollViewer></DockPanel>
     <DockPanel Grid.Column="1">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
       <WrapPanel>
        <Button x:Name="MoveScenarioStepFirst" Content="맨 위" Command="{Binding MoveStepFirstCommand}" ToolTip="선택 단계를 최상단으로 이동"/>
        <Button x:Name="MoveScenarioStepUp" Content="위로" Command="{Binding MoveStepUpCommand}" ToolTip="선택 단계를 한 단계 위로 이동"/>
        <Button x:Name="MoveScenarioStepDown" Content="아래로" Command="{Binding MoveStepDownCommand}" ToolTip="선택 단계를 한 단계 아래로 이동"/>
        <Button x:Name="MoveScenarioStepLast" Content="맨 아래" Command="{Binding MoveStepLastCommand}" ToolTip="선택 단계를 최하단으로 이동"/>
        <Button x:Name="DeleteScenarioStep" Content="선택 단계 삭제" Command="{Binding RemoveStepCommand}"/>
       </WrapPanel>
       <TextBlock Text="{Binding ScenarioOrderHint}" Foreground="#65778E" Margin="0,4,0,0"/>
      </StackPanel>
     <DataGrid x:Name="ScenarioStepGrid" ItemsSource="{Binding DraftSteps}" SelectedIndex="{Binding SelectedDraftStepIndex, Mode=TwoWay}" CanUserSortColumns="False"><DataGrid.Columns>
      <DataGridTextColumn Header="단계 종류" Binding="{Binding KindLabel}" Width="140"/>
      <DataGridTextColumn Header="역할 / 배치 ID" Binding="{Binding TargetLabel}" Width="200"/>
      <DataGridTextColumn Header="동작·조건" Binding="{Binding ActionLabel}" Width="125"/>
      <DataGridTextColumn Header="시작 전 ms" Binding="{Binding DelayBeforeMs}" Width="85"/>
      <DataGridTextColumn Header="제한 ms" Binding="{Binding TimeoutMs}" Width="85"/>
      <DataGridTextColumn Header="실패 정책" Binding="{Binding OnFailure}" Width="80"/>
     </DataGrid.Columns></DataGrid></DockPanel>
    </Grid>
   </TabItem>
   <TabItem x:Name="HandoverTab" Header="작업 · 교대">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MaxHeight="120"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MaxHeight="150"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="{Binding PreviousSummary}" Style="{StaticResource SectionTitle}"/><TextBlock Text="원 요청자·세션·snapshot을 유지합니다. 다음 사용권자는 자신의 권한 범위에서 이전 작업을 선택 취소할 수 있습니다." TextWrapping="Wrap" Foreground="#65778E" Margin="0,0,0,12"/></StackPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutomationProperties.AutomationId="JobGrid"><DataGrid.Columns>
      <DataGridCheckBoxColumn Header="이전 세션" Binding="{Binding PreviousSession}" Width="75"/><DataGridTextColumn Header="접수 시각" Binding="{Binding AcceptedAt}" Width="120"/><DataGridTextColumn Header="원 요청자 / PC" Binding="{Binding Requester}" Width="220"/><DataGridTextColumn Header="종류" Binding="{Binding Kind}" Width="85"/><DataGridTextColumn Header="작업" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="대상 / PC" Binding="{Binding Targets}" Width="250"/><DataGridTextColumn Header="단계" Binding="{Binding Progress}" Width="60"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="150"/>
     </DataGrid.Columns></DataGrid>
     <WrapPanel Grid.Row="2" Margin="0,10"><Button Content="선택 작업 취소" Command="{Binding CancelCommand}"/><Button Content="시나리오 중단 후 수동 전환…" Command="{Binding ManualSwitchCommand}"/><TextBlock Text="취소는 미전송 부분에 적용됩니다. 물리 정지나 롤백을 뜻하지 않습니다." VerticalAlignment="Center" Foreground="#8B5824"/></WrapPanel>
     <TextBox Grid.Row="3" Text="{Binding JobDetails, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0"/>
     <TextBlock Grid.Row="4" Text="{Binding HiperwallJobsSummary}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,8"/>
     <DataGrid x:Name="HiperwallJobGrid" Grid.Row="5" ItemsSource="{Binding HiperwallJobs}" SelectedItem="{Binding SelectedHiperwallJob}" AutomationProperties.AutomationId="HiperwallJobGrid"><DataGrid.Columns>
      <DataGridCheckBoxColumn Header="이전 세션" Binding="{Binding PreviousSession}" Width="75"/>
      <DataGridTextColumn Header="접수 시각" Binding="{Binding AcceptedAt}" Width="120"/>
      <DataGridTextColumn Header="원 요청자 / PC" Binding="{Binding Requester}" Width="170"/>
      <DataGridTextColumn Header="원 세션" Binding="{Binding OriginSession}" Width="85"/>
      <DataGridTextColumn Header="작업" Binding="{Binding Name}" Width="130"/>
      <DataGridTextColumn Header="대상 Controller / 인스턴스" Binding="{Binding Targets}" Width="*"/>
      <DataGridTextColumn Header="진행·결과" Binding="{Binding Progress}" Width="230"/>
      <DataGridTextColumn Header="취소 가능 범위" Binding="{Binding Cancellation}" Width="210"/>
     </DataGrid.Columns></DataGrid>
     <WrapPanel Grid.Row="6" Margin="0,8"><Button x:Name="CancelHiperwallJob" Content="{Binding HiperwallCancelLabel}" Command="{Binding CancelHiperwallJobCommand}"/><TextBlock Text="표시 종료는 열린 인스턴스 정리를 요청합니다. 불확실 결과와 정리 결과를 확인하세요." VerticalAlignment="Center" Foreground="#8B5824"/></WrapPanel>
     <TextBox Grid.Row="7" Text="{Binding HiperwallJobDetails, Mode=OneWay}" IsReadOnly="True" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0"/>
    </Grid>
   </TabItem>
   <TabItem x:Name="AdminTab" Header="관리자 설정" Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="가상 장비 등록 · 변경" Style="{StaticResource SectionTitle}"/><TextBlock Text="기존 장비는 장비 제어 탭에서 선택한 뒤 편집에 불러옵니다." TextWrapping="Wrap" Foreground="#65778E"/>
      <WrapPanel><Button Content="새 장비 ID" Command="{Binding NewDeviceCommand}"/><TextBlock Text="{Binding DeviceExpectedVersion, StringFormat=편집 기준 버전: {0}}" VerticalAlignment="Center"/></WrapPanel>
      <TextBlock Text="장비 ID"/><TextBox Text="{Binding DeviceIdText}"/><TextBlock Text="대상 PC ID"/><TextBox Text="{Binding PcIdText}"/><TextBlock Text="대상 PC의 실제 이름 (가상 등록 정보)"/><TextBox Text="{Binding PcName}"/>
      <TextBlock Text="장비 이름"/><TextBox Text="{Binding DeviceName}"/><TextBlock Text="연결 ID (현장 설정값)"/><TextBox Text="{Binding ConnectionId}"/>
      <TextBlock Text="가상 모델"/><ComboBox ItemsSource="{Binding Models}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedModel}"/>
      <WrapPanel><CheckBox Content="활성 장비" IsChecked="{Binding DeviceEnabled}" VerticalAlignment="Center" Margin="0,0,20,0"/><TextBlock Text="가상 지연 ms" VerticalAlignment="Center"/><TextBox Width="95" Text="{Binding DeviceLatencyMs, ValidatesOnExceptions=True}"/></WrapPanel>
      <TextBlock Text="가상 장애 주입"/><ComboBox ItemsSource="{Binding Faults}" SelectedItem="{Binding DeviceFault}"/>
      <Button Content="장비 설정 저장" Command="{Binding SaveDeviceCommand}" Style="{StaticResource Primary}"/>
      <Separator Margin="0,12"/><TextBlock Text="역할 배정" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="배정할 등록 장비"/><ComboBox x:Name="RoleDevicePicker" ItemsSource="{Binding Devices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding CanConfigure}"/>
      <TextBlock Text="{Binding RoleTargetSummary}" TextWrapping="Wrap" Margin="0,4"/><TextBlock Text="역할 ID (예: room.light)"/>
      <local:RoleAssignmentsView x:Name="AssignedRoleIds"/>
      <TextBox x:Name="RoleIdInput" Text="{Binding RoleName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConfigure}" ToolTip="선택 장비의 기존 역할 ID입니다. 다른 역할을 배정하려면 ID를 수정하세요."/><Button Content="선택 장비에 역할 배정" Command="{Binding SaveRoleCommand}"/>
      <TextBlock Text="{Binding RoleAssignmentHint}" TextWrapping="Wrap" Foreground="#65778E"/>
     </StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
      <local:HiperwallSettingsView x:Name="HiperwallSettings" DataContext="{Binding Hiperwall}"/>
      <TextBlock Text="앱 계정 등록 · 권한" Style="{StaticResource SectionTitle}"/><TextBlock Text="계정 이름"/><TextBox Text="{Binding NewAccountName}"/><TextBlock Text="새 계정 비밀번호 (12자 이상)"/><PasswordBox x:Name="NewAccountPassword"/>
      <TextBlock Text="앱 역할"/><ComboBox ItemsSource="{Binding AccountRoles}" SelectedItem="{Binding NewAccountRole}"/>
      <CheckBox Content="현장 전체 장비 제어 범위" IsChecked="{Binding AccountAllDevices}" Margin="0,8"/>
      <TextBlock Text="제한 범위의 장비 ID (쉼표로 구분)"/><TextBox Text="{Binding AccountDeviceIds}" TextWrapping="Wrap" MinHeight="54"/>
      <Button Content="계정 등록" Command="{Binding CreateAccountCommand}" Style="{StaticResource Primary}"/>
      <Separator Margin="0,12"/><DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Height="190"><DataGrid.Columns><DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="역할" Binding="{Binding Role}" Width="130"/><DataGridCheckBoxColumn Header="활성" Binding="{Binding Enabled}" Width="60"/></DataGrid.Columns></DataGrid>
      <Button Content="선택 계정의 권한 불러오기" Command="{Binding LoadAccountCommand}"/><CheckBox Content="계정 활성화" IsChecked="{Binding AccountEnabled}" Margin="0,8"/><Button Content="선택 계정에 활성/제어 범위 반영" Command="{Binding UpdateAccountCommand}"/>
      <TextBlock Text="계정 비활성화·제어 권한 회수는 이후 전송을 차단합니다. 기존 사용자 ID와 작업·감사 이력은 보존합니다." TextWrapping="Wrap" Foreground="#65778E" Margin="0,12"/>
      <TextBlock Text="최초 관리자 생성은 호스트 PC의 setup 명령에서만 수행합니다. 호스트 실행 계정·데이터 경로 변경과 비밀번호 분실 복구는 운영 절차를 확인하세요." TextWrapping="Wrap" Foreground="#65778E"/>
     </StackPanel></Border>
    </Grid></ScrollViewer>
   </TabItem>
   <TabItem Header="복구 · 진단">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding RecoverySummary}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10"/>
     <WrapPanel Grid.Row="1"><Button Content="3. 진행 작업 확인" Command="{Binding ReviewCommand}"/><Button Content="4. 관리자 복구 인계 승인" Command="{Binding ApproveCommand}" Style="{StaticResource Primary}"/></WrapPanel>
     <TextBox Grid.Row="2" MinHeight="80" MaxHeight="150" VerticalContentAlignment="Top" Text="{Binding ReviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8,0,12"/>
     <DataGrid x:Name="AuditGrid" Grid.Row="3" ItemsSource="{Binding Audit}" SelectedItem="{Binding SelectedAudit}" MinHeight="170" RowHeight="NaN" MinRowHeight="42">
      <DataGrid.Columns>
       <DataGridTextColumn Header="발생 시각 (이 PC 기준)" Binding="{Binding Time}" Width="160" MinWidth="160"/>
       <DataGridTextColumn Header="사용자" Binding="{Binding Actor}" Width="110" MinWidth="110"/>
       <DataGridTextColumn Header="동작" Binding="{Binding Event}" Width="150" MinWidth="150"/>
       <DataGridTextColumn Header="내용 · 최근 200건" Binding="{Binding Summary}" Width="*" MinWidth="360">
        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="6,8"/></Style></DataGridTextColumn.ElementStyle>
       </DataGridTextColumn>
      </DataGrid.Columns>
     </DataGrid>
     <Expander Grid.Row="4" Header="선택 기록의 원본 상세" Margin="0,8,0,0">
      <TextBox Text="{Binding AuditDetails, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="130"/>
     </Expander>
    </Grid>
   </TabItem>
   <TabItem x:Name="MyInfoTab" Header="내 정보">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel>
      <TextBlock Text="내 계정" Style="{StaticResource SectionTitle}"/>
      <TextBlock x:Name="MyAccountNameText" Text="{Binding MyAccountName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding MyAccountRole}" Foreground="#156D68" Margin="0,6,0,20"/>
      <TextBlock Text="제어 권한" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding MyControlScope}" TextWrapping="Wrap" Margin="0,6,0,16"/>
      <TextBlock Text="Hiperwall 제어" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding MyHiperwallPermission}" TextWrapping="Wrap" Margin="0,6,0,16"/>
      <TextBlock Text="현재 사용 상태" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding MyControlStatus}" TextWrapping="Wrap" Margin="0,6,0,16"/>
      <WrapPanel>
       <Button x:Name="HeaderLogout" Content="로그아웃" Command="{Binding LogoutCommand}" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolVisibility}}"/>
       <Button x:Name="HeaderLogin" Content="접속" Click="OpenLogin">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Primary}"><Style.Triggers><DataTrigger Binding="{Binding IsLoggedIn}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
       </Button>
       <Button x:Name="AccountSettingsButton" Content="계정 및 권한 관리" Click="OpenAccountSettings" Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}"/>
      </WrapPanel>
     </StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top"><StackPanel>
      <TextBlock Text="접속 정보" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="접속 PC" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding MyPcName}" TextWrapping="Wrap" Margin="0,6,0,16"/>
      <TextBlock Text="연결 호스트" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding MyHostEndpoint}" TextWrapping="Wrap" Margin="0,6,0,16"/>
      <TextBlock Text="연결 상태" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding ConnectionSummary}" TextWrapping="Wrap" Margin="0,6,0,16"/>
      <TextBlock Text="저장 슬롯 지원" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding MySlotSupport}" TextWrapping="Wrap" Margin="0,6,0,16"/>
      <Expander Header="계정 · 세션 식별 정보">
       <StackPanel Margin="0,8,0,0">
        <TextBlock Text="계정 ID" FontWeight="SemiBold"/><TextBlock Text="{Binding MyAccountId}" TextWrapping="Wrap" Margin="0,4,0,12"/>
        <TextBlock Text="PC ID" FontWeight="SemiBold"/><TextBlock Text="{Binding MyPcId}" TextWrapping="Wrap" Margin="0,4,0,12"/>
        <TextBlock Text="세션 ID" FontWeight="SemiBold"/><TextBlock Text="{Binding MySessionId}" TextWrapping="Wrap" Margin="0,4,0,12"/>
       </StackPanel>
      </Expander>
     </StackPanel></Border>
    </Grid></ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="1" Background="#E7EEF6" Padding="18,10"><StackPanel>
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <TextBlock Text="장비: 가상 · Hiperwall: 실장비 연동" FontSize="11" Foreground="#0C6657" Margin="0,0,16,0"/>
     <TextBlock Text="{Binding ConnectionSummary}" FontSize="11" Foreground="#536C85"/>
    </StackPanel>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,18,0" AutomationProperties.AutomationId="StatusMessage"/>
   </DockPanel>
   <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <DockPanel Margin="0,0,18,0">
     <Button DockPanel.Dock="Right" Content="접수 여부 재확인" Command="{Binding RetryCommand}" Padding="10,4" Margin="12,0,0,0"/>
     <TextBlock Text="{Binding PendingSummary}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#8B5824"/>
    </DockPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="사용 시작" Command="{Binding AcquireCommand}" Style="{StaticResource Primary}" Padding="12,5" Margin="0,0,8,0" AutomationProperties.AutomationId="AcquireButton"/>
     <Button Content="사용 종료 · 작업 유지" Command="{Binding ReleaseCommand}" Padding="12,5" Margin="0,0,8,0" AutomationProperties.AutomationId="ReleaseButton"/>
     <Button Content="새로 고침" Command="{Binding RefreshCommand}" Padding="12,5" Margin="0,0,8,0"/>
     <Button x:Name="OpenMyInfoButton" Content="내 정보" Click="OpenMyInfo" Padding="12,5" Margin="0"/>
    </StackPanel>
   </Grid>
  </StackPanel></Border>
 </Grid>
</Window>
