<UserControl x:Class="IntegratedContro.App.CameraView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="LocalBoolVisibility"/></UserControl.Resources>
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,10"><TextBlock Text="카메라 실시간 영상" Style="{StaticResource SectionTitle}"/>
   <TextBlock Text="RTSP 등록 → MediaMTX 경로 준비 → HLS 재생 · 영상 조회는 사용권 없이 가능하며 등록 변경에는 관리자 사용권이 필요합니다." TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}"/>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6" Foreground="{DynamicResource Accent}"/>
  </StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox x:Name="CameraSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="카메라 이름·위치 검색"/>
    <Button Grid.Row="1" Content="목록 새로 고침" Command="{Binding RefreshCommand}"/>
    <ListBox Grid.Row="2" x:Name="CameraList" ItemsSource="{Binding FilteredCameras}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Location}" Foreground="{DynamicResource MutedInk}" FontSize="12"/><TextBlock Text="{Binding StateLabel}" FontSize="12" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel Grid.Row="3"><Button Content="재동기화" Command="{Binding SyncCommand}"/><Button Content="삭제" Command="{Binding DeleteCommand}" Style="{StaticResource Danger}"/><Button Content="강제 삭제" Command="{Binding ForceDeleteCommand}" Style="{StaticResource Danger}"/></WrapPanel>
   </Grid>
   <Grid Grid.Column="1" Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#080F18" BorderBrush="#2B4668" BorderThickness="1" MinHeight="220">
     <ContentControl x:Name="VideoSurface" Content="{Binding VideoSurface}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Border>
    <WrapPanel Grid.Row="1" Margin="0,8"><Button x:Name="PlayCamera" Content="재생 · 다시 연결" Command="{Binding PlayCommand}" Style="{StaticResource Primary}"/><Button Content="재생 중지" Command="{Binding StopCommand}"/><CheckBox Content="영상 음소거" IsChecked="{Binding Muted}" VerticalAlignment="Center" Margin="10,0"/><Button Content="실제 입력 상태" Command="{Binding StatusCommand}"/></WrapPanel>
    <TextBlock Grid.Row="2" Text="{Binding PlaybackMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Grid.Row="3" Text="{Binding SelectedDetails}" TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}"/>
   </Grid>
   <TabControl x:Name="CameraEditorTabs" Grid.Column="2">
    <TabItem Header="등록 · 수정"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
     <WrapPanel><Button Content="새 카메라" Command="{Binding NewCommand}"/><Button Content="선택 불러오기" Command="{Binding LoadCommand}"/></WrapPanel>
     <TextBlock Text="{Binding DraftSummary}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedInk}" Margin="0,6"/>
     <StackPanel IsEnabled="{Binding CanConfigure}">
      <TextBlock Text="이름"/><TextBox x:Name="CameraNameInput" Text="{Binding CameraName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
      <TextBlock Text="위치"/><TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
      <CheckBox Content="활성화" IsChecked="{Binding Enabled}" Margin="0,8"/>
      <TextBlock Text="RTSP 주소 · 보호 입력"/><PasswordBox x:Name="RtspInput" MaxLength="2048"/>
      <TextBlock Text="RTSP 사용자 (선택)"/><PasswordBox x:Name="RtspUserInput" MaxLength="256"/>
      <TextBlock Text="RTSP 비밀번호 (선택)"/><PasswordBox x:Name="RtspPasswordInput" MaxLength="512"/>
      <TextBlock Text="주소·계정은 조회 응답에 반환하지 않습니다. 수정 시 모두 비워 두면 기존 값을 유지합니다." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedInk}" Margin="0,6"/>
      <TextBlock Text="Hiperwall Contents 매핑 (선택)" Margin="0,8,0,0"/>
      <ComboBox ItemsSource="{Binding MappingContents}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedMapping}" ToolTip="Hiperwall 탭에서 현재 Contents를 조회하세요."/>
      <CheckBox Content="기존 매핑 해제" IsChecked="{Binding ClearMapping}" Margin="0,5"/>
     </StackPanel>
     <Button x:Name="SaveCamera" Content="카메라 저장 · 경로 준비" Command="{Binding SaveCommand}" Style="{StaticResource Primary}"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="영상 서버"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
     <TextBlock x:Name="MediaStatusText" Text="{Binding MediaStatus}" FontWeight="Bold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding MediaDescription}" TextWrapping="Wrap" Margin="0,8"/>
     <TextBlock Text="{Binding AppliedMedia}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedInk}"/>
     <Border Visibility="{Binding IsLocalMedia, Converter={StaticResource LocalBoolVisibility}}" Background="{DynamicResource WarningSoft}" Padding="10" Margin="0,8">
      <StackPanel>
       <TextBlock Text="호스트가 관리하는 영상 서버" FontWeight="Bold"/>
       <TextBlock Text="{Binding LocalMediaMessage}" TextWrapping="Wrap" Margin="0,6"/>
       <StackPanel Visibility="{Binding HasLocalMediaChange, Converter={StaticResource LocalBoolVisibility}}">
        <Button x:Name="VerifyLocalMedia" Content="적용 확인 · API/HLS 인증" Command="{Binding VerifyLocalMediaCommand}" Style="{StaticResource Primary}"/>
        <Button x:Name="RetryLocalMedia" Content="파일 적용 다시 시도" Command="{Binding RetryLocalMediaCommand}"/>
        <Button x:Name="RestoreLocalMedia" Content="이전 설정 복구" Command="{Binding RestoreLocalMediaCommand}"/>
        <TextBlock Text="재시작이 필요하면 호스트 PC에서 진행하세요. 서버를 시작한 앱을 정상 종료한 뒤 다시 열거나, 수동 실행 서버는 관리자가 재시작합니다." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedInk}" Margin="0,6,0,0"/>
       </StackPanel>
      </StackPanel>
     </Border>
     <TextBlock Text="설정 변경은 관리자가 사용 시작 후 진행할 수 있습니다." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedInk}" Margin="0,8"/>
     <Expander x:Name="MediaSettingsEditor" Header="{Binding MediaEditorLabel}" IsEnabled="{Binding CanManageMedia}" IsExpanded="{Binding IsMediaEditorOpen, Mode=TwoWay}" Margin="0,6">
      <StackPanel>
       <TextBlock Text="{Binding MediaEditorMessage}" TextWrapping="Wrap" Margin="0,6" Foreground="{DynamicResource Accent}"/>
       <StackPanel IsEnabled="{Binding CanManageMedia}">
        <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsLocalMedia}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
         <TextBlock Text="제어 API 주소 · 호스트에서 접근"/><TextBox x:Name="ApiEndpointInput" IsEnabled="{Binding CanEditMediaTarget}" Text="{Binding ApiEndpoint, UpdateSourceTrigger=PropertyChanged}" ToolTip="http(s)://주소:9997"/>
         <TextBlock Text="HLS 주소 · 호스트에서 접근"/><TextBox IsEnabled="{Binding CanEditMediaTarget}" Text="{Binding HlsEndpoint, UpdateSourceTrigger=PropertyChanged}" ToolTip="http(s)://주소:8888"/>
         <TextBlock Text="API 전용 사용자"/><TextBox IsEnabled="{Binding CanEditMediaTarget}" Text="{Binding ApiUser, UpdateSourceTrigger=PropertyChanged}"/>
         <TextBlock Text="HLS 읽기 전용 사용자"/><TextBox IsEnabled="{Binding CanEditMediaTarget}" Text="{Binding HlsUser, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <TextBlock Text="API 비밀번호 · 변경할 때만 입력"/><PasswordBox x:Name="ApiPasswordInput" IsEnabled="{Binding CanEditMediaPasswords}" MaxLength="512"/>
        <TextBlock Text="HLS 비밀번호 · 변경할 때만 입력"/><PasswordBox x:Name="HlsPasswordInput" IsEnabled="{Binding CanEditMediaPasswords}" MaxLength="512"/>
       </StackPanel>
       <Button x:Name="SaveMediaSettings" Content="{Binding SaveMediaLabel}" Command="{Binding SaveSettingsCommand}" Style="{StaticResource Primary}"/>
       <TextBlock Text="같은 서버·계정을 수정할 때 비밀번호를 비워 두면 기존 값을 유지합니다. 최초 등록이나 서버·계정 변경 시에는 두 비밀번호가 필요합니다. 호스트가 자동 생성한 서버의 새 비밀번호는 각각 12자 이상이며 서로 달라야 합니다. 카메라·정리 큐가 남아 있으면 서버 대상을 변경할 수 없습니다." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedInk}"/>
      </StackPanel>
     </Expander>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
  </Grid>
  <Expander Grid.Row="2" Header="강제 삭제 경로 정리" Margin="0,12,0,0"><StackPanel><Button Content="정리 큐 다시 시도" Command="{Binding RetryCleanupCommand}" HorizontalAlignment="Left"/><ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding CleanupSummary}" TextWrapping="Wrap"/></ScrollViewer></StackPanel></Expander>
 </Grid>
</UserControl>
