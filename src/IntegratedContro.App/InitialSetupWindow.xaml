<Window x:Class="IntegratedContro.App.InitialSetupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource AppWindow}" Title="IntegratedContro · 시작 설정" Width="700" Height="800" MinHeight="480" MinWidth="620"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="SetupScroll" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="0,0,12,0">
    <TextBlock Text="IntegratedContro 시작하기" FontSize="25" FontWeight="Bold" Margin="0,0,0,12"/>
    <StackPanel x:Name="SetupChoices" Visibility="{Binding IsChoosingMode, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanEdit}">
     <TextBlock Text="이 PC에서 사용할 방식을 선택하세요." FontSize="16" Margin="0,0,0,24" Foreground="{DynamicResource MutedInk}"/>
     <Button x:Name="StartNew" Click="ChooseNew" HorizontalContentAlignment="Stretch" Padding="20" MinHeight="112" Margin="0,0,0,14">
      <StackPanel>
       <TextBlock Text="새로 시작" FontSize="20" FontWeight="Bold"/>
       <TextBlock Text="저장 위치와 관리자 계정을 설정하고 바로 접속합니다." TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
     </Button>
     <Button x:Name="ConnectExistingServer" Click="ChooseRemote" HorizontalContentAlignment="Stretch" Padding="20" MinHeight="112" Margin="0,0,0,14">
      <StackPanel>
       <TextBlock Text="기존 서버 접속" FontSize="20" FontWeight="Bold"/>
       <TextBlock Text="서버 주소와 인증서 지문을 등록하고 기존 계정으로 로그인합니다." TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
     </Button>
     <Button x:Name="UseExistingData" Click="ChooseExisting" HorizontalContentAlignment="Stretch" Padding="20" MinHeight="112">
      <StackPanel>
       <TextBlock Text="기존 데이터 사용" FontSize="20" FontWeight="Bold"/>
       <TextBlock Text="기존 폴더를 연결해 현장·계정·작업 기록을 이어서 사용합니다." TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
     </Button>
     <TextBlock Text="저장된 접속 설정이 있으면 다음 실행부터 이 과정을 건너뜁니다." TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}" Margin="0,24,0,0"/>
    </StackPanel>
    <StackPanel x:Name="SetupEditor" Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}">
     <StackPanel IsEnabled="{Binding CanEdit}">
     <DockPanel Margin="0,0,0,16">
      <Button Content="‹ 사용 방식 다시 선택" Click="BackToChoices" DockPanel.Dock="Right" Margin="12,0,0,0"/>
      <ComboBox x:Name="SetupMode" SelectedIndex="{Binding ModeIndex}" MinHeight="48" AutomationProperties.Name="사용 방식">
      <ComboBoxItem Content="새로 시작"/>
      <ComboBoxItem Content="기존 데이터 사용"/>
      <ComboBoxItem Content="기존 서버 접속"/>
      </ComboBox>
     </DockPanel>
     <StackPanel Visibility="{Binding IsLocal, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="운영 데이터 폴더" FontWeight="Bold"/>
      <DockPanel Margin="0,6,0,8">
       <Button Content="폴더 선택" DockPanel.Dock="Right" Click="BrowseData" MinHeight="48" Margin="8,0,0,0"/>
       <TextBox x:Name="DataFolder" Text="{Binding DataPath, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="48"/>
      </DockPanel>
      <TextBlock Visibility="{Binding IsExistingData, Converter={StaticResource BoolVisibility}}" Text="기존 데이터는 서버를 정상 종료한 뒤 폴더 전체를 선택하세요. 계정과 작업 기록은 그대로 유지됩니다." TextWrapping="Wrap" Margin="0,8,0,16" Foreground="{DynamicResource MutedInk}"/>
      <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolVisibility}}">
       <TextBlock Text="현장 이름과 관리자 계정을 입력하세요. 서버 실행을 승인하면 이 계정으로 바로 접속합니다." TextWrapping="Wrap" Margin="0,0,0,12"/>
       <TextBlock Text="현장 이름"/><TextBox x:Name="SiteName" Text="{Binding SiteName, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" Margin="0,4,0,10"/>
       <TextBlock Text="최초 관리자 아이디"/><TextBox x:Name="AdminName" Text="{Binding Administrator, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" Margin="0,4,0,10"/>
       <TextBlock Text="관리자 비밀번호 · 12자 이상"/><PasswordBox x:Name="AdminPassword" MinHeight="44" Margin="0,4,0,10"/>
       <TextBlock Text="비밀번호 확인"/><PasswordBox x:Name="ConfirmPassword" MinHeight="44" Margin="0,4,0,10"/>
       <Expander Header="서버 수신 주소 · 고급 설정" Margin="0,0,0,12"><StackPanel Margin="0,8,0,0">
       <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0"><TextBlock Text="서버 수신 IP"/><TextBox Text="{Binding BindAddress, UpdateSourceTrigger=PropertyChanged}" MinHeight="44"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="HTTPS 포트"/><TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" MinHeight="44"/></StackPanel>
       </Grid>
       <TextBlock Text="127.0.0.1은 이 PC에서만 접속합니다. 다른 PC에서도 사용할 때는 실제 수신 IP 또는 0.0.0.0을 지정하세요." TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,12"/>
       </StackPanel></Expander>
      </StackPanel>
      <CheckBox x:Name="EnableMedia" Content="영상 서버 사용 · 앱 시작 시 실행 여부 확인" IsChecked="{Binding MediaEnabled}" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding MediaSetupSummary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,12"/>
      <Expander x:Name="MediaSetupSection" Header="영상 서버 · 고급 설정" Margin="0,0,0,12">
       <StackPanel Margin="0,10,0,0">
        <StackPanel IsEnabled="{Binding MediaEnabled}">
         <ComboBox x:Name="MediaSetupMode" SelectedIndex="{Binding MediaModeIndex}" MinHeight="48" Margin="0,0,0,12">
          <ComboBoxItem Content="자동 생성 · 연결 확인 (이 PC)"/>
          <ComboBoxItem Content="기존 설정 파일 사용"/>
         </ComboBox>
         <StackPanel Visibility="{Binding IsAutomaticMedia, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="설정 파일과 API/HLS 전용 비밀번호를 생성하고 ControlHost에 같은 접속 정보를 등록합니다. 파일 편집이나 비밀번호 복사는 필요 없습니다." TextWrapping="Wrap" Margin="0,0,0,10"/>
          <Grid Margin="0,0,0,10">
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
           <StackPanel Margin="0,0,8,0"><TextBlock Text="API 포트"/><TextBox x:Name="MediaApiPortInput" Text="{Binding MediaApiPort}" MinHeight="44"/></StackPanel>
           <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="HLS 포트"/><TextBox x:Name="MediaHlsPortInput" Text="{Binding MediaHlsPort}" MinHeight="44"/></StackPanel>
           <StackPanel Grid.Column="2"><TextBlock Text="RTSP 포트"/><TextBox x:Name="MediaRtspPortInput" Text="{Binding MediaRtspPort}" MinHeight="44"/></StackPanel>
          </Grid>
          <TextBlock Text="저장하면 영상 서버를 잠시 실행해 API/HLS 인증 연결을 확인한 뒤 종료합니다. 완료 후 서버 실행 여부를 묻습니다. 기존 로컬 서버는 먼저 정상 종료하세요." TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,10"/>
          <TextBlock Text="설정은 선택한 운영 데이터 폴더의 MediaMTX 폴더에 저장됩니다. 영상 서버는 이 PC에서만 접속하며 다른 PC의 앱은 ControlHost를 통해 영상을 받습니다. 카메라 영상 입력은 등록 후 별도로 확인하세요." TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}"/>
         </StackPanel>
         <StackPanel Visibility="{Binding IsExistingMedia, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="기존 MediaMTX 설정 파일의 절대 경로"/><TextBox Text="{Binding MediaConfiguration}" MinHeight="44" Margin="0,4,0,10"/>
          <TextBlock Text="MediaMTX API 주소"/><TextBox Text="{Binding MediaApi}" MinHeight="44" Margin="0,4,0,10"/>
          <TextBlock Text="기존 파일과 계정을 유지합니다. 로그인 후 카메라 · 영상 → 영상 서버에서 호스트의 영상 설정을 자동으로 사용합니다." TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}"/>
         </StackPanel>
        </StackPanel>
       </StackPanel>
      </Expander>
     </StackPanel>
     <StackPanel Visibility="{Binding IsRemote, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="호스트 HTTPS 주소"/><TextBox x:Name="RemoteEndpoint" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" Margin="0,5,0,12"/>
      <TextBlock Text="호스트 인증서 SHA-256 지문"/><TextBox Text="{Binding Fingerprint, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="60" Margin="0,5,0,12"/>
      <TextBlock Text="서버 관리자가 제공한 주소와 지문을 입력하세요. 운영 데이터 폴더는 원격 서버에서 관리합니다." TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}"/>
     </StackPanel>
     </StackPanel>
     <Expander Header="저장 위치 · 설정 상태" Margin="0,16,0,0">
      <StackPanel Margin="0,10,0,0">
       <TextBlock Text="{Binding Status.Title}" FontWeight="Bold"/>
       <TextBlock Text="{Binding Status.Description}" TextWrapping="Wrap" Margin="0,6,0,12"/>
       <TextBlock Text="접속·화면 설정 저장 위치" Foreground="{DynamicResource MutedInk}"/>
       <TextBlock Text="{Binding ProfileLocation}" TextWrapping="Wrap"/>
       <TextBlock Text="서버 시작 설정 저장 위치" Foreground="{DynamicResource MutedInk}" Margin="0,8,0,0"/>
       <TextBlock Text="{Binding SettingsLocation}" TextWrapping="Wrap"/>
       <TextBlock Text="설정과 운영 데이터는 업데이트 후에도 유지됩니다." Foreground="{DynamicResource MutedInk}" Margin="0,8,0,0"/>
      </StackPanel>
     </Expander>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="1" Margin="0,12,0,0">
   <TextBlock x:Name="SetupMessage" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource WarningInk}" Margin="0,0,0,12"/>
   <WrapPanel HorizontalAlignment="Right">
    <Button Content="서버 설정 백업 복구" Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}" Command="{Binding RestoreBackupCommand}" MinHeight="48" Margin="0,0,8,0"/>
    <Button Content="닫기" IsCancel="True" IsEnabled="{Binding CanEdit}" MinHeight="48" Margin="0,0,8,0"/>
    <Button x:Name="SaveSetup" Content="{Binding SaveLabel}" Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}" IsDefault="True" Command="{Binding SaveCommand}" Style="{StaticResource Primary}" MinHeight="48"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</Window>
