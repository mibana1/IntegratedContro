<UserControl x:Class="IntegratedContro.App.ScenarioSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IntegratedContro.App">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="SettingsVisibility"/>
  <Style x:Key="SettingOption" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="48"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True">
    <Setter Property="Background" Value="{DynamicResource AccentFill}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
   </DataTrigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <ItemsControl x:Name="DeviceSettingsItems" ItemsSource="{Binding ScenarioSettings}">
  <ItemsControl.ItemTemplate><DataTemplate>
   <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource SubtleSurface}" CornerRadius="6" Padding="10" Margin="0,0,4,8">
    <StackPanel>
     <CheckBox x:Name="IncludeSetting" IsChecked="{Binding Included}" Content="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,5"/>
     <ItemsControl ItemsSource="{Binding Options}" Visibility="{Binding HasOptions, Converter={StaticResource SettingsVisibility}}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button Content="{Binding Label}" Command="{Binding SelectCommand}" Style="{StaticResource SettingOption}" AutomationProperties.Name="{Binding Label}"/>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <StackPanel Visibility="{Binding IsRange, Converter={StaticResource SettingsVisibility}}">
      <local:TouchSlider x:Name="ValueSlider" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" SmallChange="1" Margin="0,6" AutomationProperties.Name="{Binding Label}"/>
      <DockPanel><TextBox x:Name="ValueInput" Width="70" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"/>
       <TextBlock Text="{Binding Range}" VerticalAlignment="Center"/></DockPanel>
     </StackPanel>
     <StackPanel Visibility="{Binding IsNumeric, Converter={StaticResource SettingsVisibility}}">
      <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"/>
      <TextBlock Text="{Binding Range}"/>
     </StackPanel>
     <TextBlock Text="{Binding ValueLabel}" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </DataTemplate></ItemsControl.ItemTemplate>
 </ItemsControl>
</UserControl>
