<Project><PropertyGroup>
<TargetFramework>net10.0</TargetFramework><RuntimeIdentifiers>win-x64</RuntimeIdentifiers><RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
<LangVersion>14.0</LangVersion><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><PlatformTarget>x64</PlatformTarget><Deterministic>true</Deterministic>
</PropertyGroup></Project>
